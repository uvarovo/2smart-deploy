{
    "title": "Weather Bridge (Open-Meteo)",
    "type": "openweathermap-bridge",
    "registry": "uvarovo/2smart-standalone-openweathermap-bridge",
    "configuration": {
        "fields": [
            {
                "name": "DEVICE_NAME",
                "type": "string",
                "label": "Device name",
                "default": "OpenWeatherMap Bridge",
                "validation": [
                    "string"
                ]
            },
            {
                "name": "CITY",
                "type": "string",
                "label": "City (e.g. Domodedovo)",
                "default": "",
                "validation": [
                    "string"
                ]
            },
            {
                "name": "COORDINATES",
                "type": "string",
                "label": "Coordinates (lat, lon) e.g. 55.28, 37.96",
                "default": "",
                "validation": [
                    "string"
                ]
            },
            {
                "name": "DEBUG",
                "type": "string",
                "label": "Debug",
                "default": null
            }
        ],
        "volumes": {
            "{BRIDGE}/openweathermap": "/etc/openweathermap"
        }
    },
    "icon": "favicon.svg",
    "released_at": "2026-05-19 09:30:00",
    "version": "market-fixed"
}